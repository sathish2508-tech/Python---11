M = int(input())
N = int(input())
K = 0
for k in range(1, N + 1):
    K += k 
S = K + M - 1
for i in range(N):
    row = ""
    space = "  " * i 
    if i == 0:
        for j in range(N):
            row += str(S) + " "
            S -= 1 
    elif i == N-1:
        row += str(S) + " "
        S -= 1 
    else:
        hspace = "  " * (N-(i+2))
        first =  str(S) + " "
        second =  str(S-(N-i-1)) + " "
        row += first + hspace + second
        S -= N-i
    print(space+row)
