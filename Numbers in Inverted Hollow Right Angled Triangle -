M = int(input())
N = int(input())
for i in range(1, N + 1):
    space = "  " * (i-1)
    if i == 1:
        row = ""
        for j in range(N):
            row += str(M) + " "
            M += 1
        print(row)
    elif i == N:
        row = ""
        row += str(M) + " "
        bt = space + row
        print(bt)
    else:
        row = ""
        hspace = "  " * (N-i-1)
        row += str(M) + " "
        row += hspace
        M += 1
        row += str(M) + " "
        M += 1 
        print(space+row)
        
