N = int(input())
for i in range(1, N + 1):
    if i == 1:
        space = "  " * (N-i)
        row = ""
        row += space + str(1) + " "
        print(row)
    elif i == N:
        row = ""
        for j in range(1, N + 1):
            row = str(j) + " " + row
        print(row)
    else:
        space = "  " * (N-i)
        hspace = "  " * (i-2)
        row = ""
        row += space + str(i) + " " + hspace + str(1) + " "
        print(row)
