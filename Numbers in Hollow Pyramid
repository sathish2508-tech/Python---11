N = int(input())
for i in range(1, N + 1):
    if i == 1:
        row = ""
        row += str(5) + " "
        space = " " * (N-i)
        top = space + row
        print(top)
    elif i == N:
        row = ""
        for j in range(N):
            row += str(5+j) + " "
        print(row)
    else:
        row = ""
        space = " " * (N-i)
        hollow_space = " " * (2*(i)-4)
        row = space + str(5) + " " + hollow_space + str(5+i-1) + " "
        print(row)
