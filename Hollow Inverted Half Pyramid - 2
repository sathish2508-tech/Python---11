N = int(input())
for i in range(1,N+1):
    if i == 1:
        row = ""
        for j in range(1, N + 1):
            row += str(j) + " "
        print(row)
    elif i == N:
        row = ""
        row += str(1) + " "
        print(row)
    else:
        space = " " * 2*(N-i-1)
        row = ""
        row += str(1) + " " + space + str(N-i+1) + " "
        print(row)
