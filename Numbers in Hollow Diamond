N = int(input())
M = 2*N-1
for i in range(1, M + 1):
    if (i == 1 or i == M):
        space = " " * (N-1)
        print(space + "1 ")
    elif (i <= N):
        space = " " * (N-i)
        hspace = " " * (2*(i-2))
        print(space + "1 " + hspace + str(i) + " ")
    else:
        reverse = M-i+1 
        hspace = " " * (2*(reverse - 2))
        space = " " * (i-N)
        print(space + "1 " + hspace + str(reverse) + " ")
