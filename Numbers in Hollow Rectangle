M = int(input())
N = int(input())
k = 7+N-1
S = 7
for i in range(1, M + 1):
    if i == 1 or i == M:
        for j in range(N):
            print(str(S+j),end=" ")
        print()
    else:
        space = "  " * (N-2)
        row = ""
        row += str(7) + " " + space + str(k) + " "
        print(row)
