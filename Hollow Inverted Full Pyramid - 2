N = int(input())
for i in range(1, N + 1):
    if i == 1:
        row = ""
        for j in range(1, N + 1):
            row += str(j) + " "
    elif i == N:
        row = ""
        space = " " * (i-1)
        row += space + str(1) + " "
    else:
        space = " " * (i-1)
        hspace = " " * 2*(N-i-1)
        row = ""
        row += space + str(1) + " " + hspace + str(N-i+1) + " "
    print(row)
