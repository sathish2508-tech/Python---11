N = int(input())
for i in range(1, N + 1):
    if i == 1:
        row = ""
        row += str(1) + " "
        space = " " * (N-i)
        top = space + row
        print(top)
    elif i == N:
        row = ""
        for j in range(1, N + 1):
            row += str(j) + " "
        print(row)
    else:
        left_space = " " * (N-i)
        middle_space = " " * (2*(i)-4)
        row = ""
        row = left_space + str(1) + " " + middle_space + str(i) + " " 
        print(row)
